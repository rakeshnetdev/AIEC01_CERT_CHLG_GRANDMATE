# Base URL of the deployed backend, with no trailing slash.
# Local dev:  http://localhost:9392
# Production: https://<your-service>.onrender.com
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle, and this value is
# baked in at BUILD time — changing it in Vercel requires a redeploy, not just a restart.
VITE_BACKEND_URL=http://localhost:9392
